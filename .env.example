# ==============================================================================
# VICTOR AI Configuration & Multi-Provider Architecture
# Priority Resolution:
#   Tier 1 (Primary):   Gemini Live API (GEMINI_API_KEY)
#   Tier 2 (Secondary): ChatGPT / OpenAI API (OPENAI_API_KEY)
#   Tier 3 (Tertiary):  Local LLM via Ollama (OLLAMA_HOST / deepseek-r1 / llama3.2)
# ==============================================================================

# --- TIER 1: GOOGLE GEMINI LIVE API (PRIMARY & RECOMMENDED) ---
# Provides real-time bidirectional streaming audio, continuous camera vision, and instant responses.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Voice Persona for Gemini:
# Options: 'Charon'   (Optimus Prime / Lord Megatron deep bass)
#          'Fenrir'   (J.A.R.V.I.S. / crisp sharp baritone)
#          'Aoede'    (Articulate, elegant female)
#          'Kore'     (Calm, soothing female)
#          'Puck'     (Energetic, witty)
#          'metallic' (6th Cybernetic profile with real-time hardware DSP comb filtering)
VICTOR_VOICE=Charon

# --- TIER 2: OPENAI / CHATGPT (SECONDARY FALLBACK) ---
# Automatically used if GEMINI_API_KEY is not configured or if VICTOR_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- TIER 3: LOCAL OLLAMA MODELS (OFFLINE / PRIVACY) ---
# Automatically used if neither Gemini nor OpenAI API keys are provided.
# Completely offline. Requires Ollama (https://ollama.com).
# Popular models: 'qwen2.5-coder:7b' (recommended for coding), 'deepseek-r1:7b' (deep reasoning), 'llama3.2:3b'
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# --- PROVIDER OVERRIDE (OPTIONAL) ---
# Force a specific engine: 'gemini', 'openai', or 'ollama'.
# Leave commented out for automatic zero-collision tier resolution.
# VICTOR_PROVIDER=gemini
